{
    "name": "orangepix/op_htmlblocks",
    "description": "OrangePix Module",
    "type": "prestashop-module",
    "license": "licensed",
    "authors": [
        {
            "name": "Carlos Batista",
            "email": "carlos.batista@orangepix.it"
        }
    ],
    "autoload": {
        "psr-4": {
            "OrangePix\\Classes\\": "classes/",
            "OrangePix\\Repository\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=7.0.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": ">=3.0",
        "squizlabs/php_codesniffer": ">=3.0",
        "prestashop/autoindex": ">=2.0",
        "prestashop/header-stamp": ">=2.0",
        "phpunit/phpunit": ">=9.5"
    },
    "config": {
        "preferred-install": "dist",
        "prepend-autoloader": false,
        "process-timeout": 0
    },
    "scripts": {
        "git-clean": "rm -rf .git",
        "make-test-folder": "mkdir tests",
        "test": "phpunit tests",
        "vendor-clean": "composer install --no-dev",
        "autoindex": "php vendor/bin/autoindex prestashop:add:index",
        "copyright": "php vendor/bin/header-stamp --exclude=vendor,node_modules --license=src/assets/copyright.txt --extensions=html,js,css,scss,php,tpl,twig",
        "check-php": "find . -type f -name '*.php' ! -path './vendor/*' ! -path './tests/*' -exec php -l -n {} \\;",
        "format-inspect": "php vendor/bin/php-cs-fixer fix --dry-run --allow-risky=yes --config=.php-cs-fixer.php",
        "format": "php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes"
    },
    "scripts-descriptions": {
        "git-clean": "Remove default git repo after clone",
        "make-test-folder": "Create tests Dir for testing purposes",
        "test": "Run all tests",
        "vendor-clean": "Remove Dev dependencies from vendor folder",
        "autoindex": "Create recursive Prestashop file index.php on module folder",
        "copyright": "Update recursive copyright notice on module folder",
        "check-php": "Check if code is compatible with an actual version of PHP",
        "format-inspect": "Check if code is compatible with PSR12 standard",
        "format": "Reformat code with PSR12 standard"
    }
}